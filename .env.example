# VisualFind — Environment Variables
# Copy to .env and fill in your values before running the server.
# Never commit .env to version control.

# ── FastAPI / Uvicorn ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# ── Catalog & Index ───────────────────────────────────────────────────────────
# Number of images to index (change to a larger value or remove for full catalog)
MAX_IMAGES=1600

# Batch size for embedding extraction during build_index.py
EMBEDDING_BATCH_SIZE=16

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
