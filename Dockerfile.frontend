# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.frontend — VisualFind Frontend (Nginx static server)
# ─────────────────────────────────────────────────────────────────────────────
# Serves the React CDN frontend (no build step required) via Nginx.
#
# Build:   docker build -f Dockerfile.frontend -t visualfind-frontend .
# Run:     docker run -p 8080:80 visualfind-frontend
# ─────────────────────────────────────────────────────────────────────────────

FROM nginx:1.27-alpine

LABEL maintainer="VisualFind" \
      description="VisualFind React Frontend — served by Nginx" \
      version="1.0.0"

# Remove default nginx config and static files
RUN rm -f /etc/nginx/conf.d/default.conf && \
    rm -rf /usr/share/nginx/html/*

# Copy frontend source files
COPY frontend/ /usr/share/nginx/html/

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/visualfind.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/health.txt || exit 1

CMD ["nginx", "-g", "daemon off;"]
